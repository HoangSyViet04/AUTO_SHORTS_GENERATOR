    { "id": "upload-to-publish", "from": "final_upload", "to": "publish_center", "label": "video + caption", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "id": "publish-to-refresh", "from": "publish_center", "to": "token_refresh", "label": "kiểm tra token / refresh 401", "variant": "security", "role": "main" },
    { "id": "refresh-to-tiktok", "from": "token_refresh", "to": "tiktok", "label": "Direct Post + chunks", "variant": "security", "role": "main" },
    { "id": "publish-to-facebook", "from": "publish_center", "to": "facebook", "label": "start → upload → finish", "variant": "emphasis", "role": "main" }
