    { "id": "vi-to-enhance", "from": "vi_srt", "to": "tts_enhance", "label": "semantic text chunks", "variant": "emphasis", "role": "main" },
    { "id": "enhance-to-tts", "from": "tts_enhance", "to": "elevenlabs", "label": "text + emotion + context", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "id": "tts-to-fit", "from": "elevenlabs", "to": "timeline_fit", "label": "MP3 chunks", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "id": "fit-to-audio", "from": "timeline_fit", "to": "voice_audio", "label": "audio đã fit duration", "variant": "default", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "id": "audio-to-bundle", "from": "voice_audio", "to": "output_bundle", "label": "voice + metadata", "variant": "emphasis", "role": "main" },
    { "id": "assets-to-bundle", "from": "content_assets", "to": "output_bundle", "label": "caption + comment files", "variant": "dashed", "role": "branch" },
    { "id": "bundle-to-capcut", "from": "output_bundle", "to": "capcut", "label": "import 4 assets", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "id": "bundle-to-manual", "from": "output_bundle", "to": "manual_import", "label": "thiếu CAPCUT_PATH", "variant": "dashed", "role": "branch" },
    { "id": "capcut-to-final", "from": "capcut", "to": "final_video", "label": "edit + export", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "straight" },
