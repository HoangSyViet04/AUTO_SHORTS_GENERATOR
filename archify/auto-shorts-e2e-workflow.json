  "cards": [
    {
      "dot": "violet",
      "title": "Luồng dữ liệu chính",
      "items": [
        "Video được lưu local trước khi pipeline chạy trong subprocess riêng.",
        "Whisper tạo SRT Trung; Gemini rewrite toàn bộ SRT và giữ nguyên timestamp.",
        "ElevenLabs tạo voice theo semantic chunks, sau đó timeline fitter căn duration video."
      ]
    },
    {
      "dot": "emerald",
      "title": "Bộ output đưa vào CapCut",
      "items": [
        "video_goc.mp4 hoặc MKV",
        "sub_viet.srt và giong_doc_viet.mp3",
        "logo.png luôn được copy khi file nguồn tồn tại",
        "Caption/comment được lưu cùng project để dùng lúc đăng bài."
      ]
    },
    {
      "dot": "amber",
      "title": "Nhánh phục hồi",
      "items": [
        "Whisper thử lại không VAD nếu lần đầu không có caption.",
        "Gemini retry ba lần rồi mới dùng Google Translate fallback.",
        "Thiếu CAPCUT_PATH thì mở thư mục output để import thủ công.",
        "TikTok token hết hạn sẽ refresh và retry một lần."
      ]
    },
    {
      "dot": "cyan",
      "title": "Điều kiện xuất bản",
      "items": [
        "Người dùng phải có video_final.mp4 và caption trước khi nút đăng được bật.",
        "TikTok cần Access Token; Facebook cần Page ID + Page Access Token.",
        "Mỗi nền tảng nhận video final từ Publish Center qua API riêng."
      ]
    }
  ]
}
