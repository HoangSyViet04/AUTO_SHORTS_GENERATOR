    "views": [
      {
        "id": "happy_path",
        "label": "Luồng xử lý chính",
        "focus": ["source_video", "desktop_ui", "upload_api", "input_store", "pipeline_worker", "whisper", "zh_srt", "gemini_rewrite", "vi_srt", "tts_enhance", "elevenlabs", "timeline_fit", "output_bundle", "capcut", "final_video", "publish_center"],
